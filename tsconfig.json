{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["browser"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": { "libniimai": ["./packages/libniimai/src/index.ts"] },
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "node", "web-bluetooth", "w3c-web-usb"]
  },
  "include": ["src", "vite.config.ts"]
}
